# Application Configuration
APP_NAME="Smart Question Paper Generator"
APP_VERSION="1.0.0"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Security & CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
MAX_UPLOAD_SIZE_MB=15

# Temporary file storage
TEMP_DIR="./temp_files"

# Cloud LLM Configuration (Optional: Local deterministic processing runs if unset)
# NOTE: No local LLM (Ollama, etc.) or GPU required. Uses lightweight cloud APIs only when enabled.
# Supported providers: gemini (recommended), openai, anthropic
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"
LLM_API_KEY="your-cloud-api-key-here"
LLM_ENABLED=false
